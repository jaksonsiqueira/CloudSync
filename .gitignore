# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/

# Test, type-checker, and editor caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.idea/
.vscode/

# Local application data, databases, logs, and temporary files
*.sqlite
*.sqlite3
*.db
*.db-*
*.sqlite-*
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo

# Environment variables and local secrets
.env
.env.*
!.env.example
credentials.json
client_secret*.json
google-oauth-client.json
token.json
token*.json
secrets.*
*.pem
*.key
*.p12
